---
layout: layout.vto
---
{{ comp Sideindhold }}
<article class="space-y-8">
  <div class="bokser max-w-3xl mx-auto text-left text-white">
  <div class="text-sm tracking-wider">
    <time>{{ dato |> date("HUMAN_DATE", "da") }}</time>
  </div>
  <h1 class="mb-3 mt-2 font-serif text-5xl mb-2">{{ titel }}</h1>
  <h2 class="italic mb-8">Af {{kunstner.titel}}</h2>
  {{ content }}
  </div>

  {{ if kunstner }}
    {{ comp Indholdskasse }}
      <div class="flex items-center gap-4 mb-4">
        {{ comp Kunstnerbillede { kunstner, klasse: "w-16 h-16" } }}
        {{ /comp }}
        <div>
          <div class="font-serif text-lg">{{ kunstner.titel }}</div>
          <div class="text-sm text-zinc-700">{{ kunstner.hurtigtekst |> md(true) }}</div>
        </div>
      </div>
      <a href="{{ kunstner.url }}" class="inline-block border border-zinc-600 px-4 py-2 hover:border-violet-700 hover:text-violet-800 transition-all">
        Gå til {{ kunstner.titel }}s side
      </a>
    {{ /comp }}
  {{ /if }}
</article>
{{ /comp }}
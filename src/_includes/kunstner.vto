---
layout: layout.vto
---
{{ comp Sideindhold }}
{{ comp Broedkrummer }}
  {{ comp Broedkrumme }}
    {{ titel }}
  {{ /comp }}
{{ /comp }}

<div class="space-y-8">
  {{ comp Indholdskasse }}
    <div class="px-2 lg:px-0 flex items-center gap-4 mb-4">
      {{ comp Kunstnerbillede { kunstner: { id, titel, gif, billede }, klasse: "w-20 h-20" } }}
      {{ /comp }}
      <div>
        <h1 class="font-serif text-4xl mb-2">{{ titel }}</h1>
        <!--<div class="text-sm tracking-wider text-zinc-700">Joined {{ joined }}</div>-->
      </div>
    </div>
    
    <div class="px-2 lg:px-0 font-serif leading-relaxed text-zinc-700 [&>*+*]:mt-[1lh]">
      {{ content |> md }}
    </div>
  {{ /comp }}

  <div>
    <h2 class="mb-4 font-serif text-2xl">Opslag</h2>
    {{ include "templates/opslags-liste.vto" { opslagsListe: search.pages(`type=opslag|svar kunstner_id=${id} udgivet=ja`, "dato=desc"), medsejhed: true } }}
  </div>
</div>
{{ /comp }}
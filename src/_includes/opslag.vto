---
layout: layout.vto
---
{{ comp Sideindhold }}
{{ comp Broedkrummer }}
  {{ comp Broedkrumme }}
    {{ titel }}
  {{ /comp }}
{{ /comp }}

{{# Afsnittene deles op ved hver "ny kasse": det første stykke kommer i opslagets kasse, resten i hver sin kasse #}}
{{ set kasser = [{ afsnit: [] }] }}
{{ for blok of afsnit ?? [] }}
  {{ if blok.type === "kasse" }}
    {{> kasser.push({ ...blok, afsnit: [] }) }}
  {{ else }}
    {{> kasser.at(-1).afsnit.push(blok) }}
  {{ /if }}
{{ /for }}

<article class="space-y-8">
  {{ comp Indholdskasse }}
    {{ comp Indholdskassehoved }}
      {{ comp Indholdskassetitel }}
        {{ titel }}
      {{ /comp }}
      {{ comp Indholdskassesubtitel }}
        <time>{{ dato |> date("HUMAN_DATE", "da") }}</time>
      {{ /comp }}
    {{ /comp }}
    {{ if intro }}
      <div class="whitespace-pre-wrap">{{ intro }}</div>
    {{ /if }}
    {{ if content || kasser[0].afsnit.length || type === "korrespondance" }}
    {{ comp Indholdskasseindhold { css: kassecss } }}
      <div class="overflow-x-hidden">
        {{ content }}
        {{ if kasser[0].afsnit.length }}
          {{ comp Afsnit { afsnit: kasser[0].afsnit, tekststoerrelse, tekststoerrelse_mobil, tekststoerrelse_computer, linjeafstand } }}
          {{ /comp }}
        {{ /if }}
        {{ if type === "korrespondance" }}
          <a href="/korrespondance/" class="mt-6 inline-block border border-zinc-600 px-4 py-2 hover:border-violet-700 hover:text-violet-800 transition-all">
            Om korrespondance-formatet
          </a>
        {{ /if }}
      </div>
    {{ /comp }}
    {{ /if }}
    {{ if korrespondance }}
    <div class="px-2 lg:px-0">
      <a href="{{ korrespondance.url }}" class="inline-block mt-4 border border-zinc-600 px-4 py-2 hover:border-violet-700 hover:text-violet-800 transition-all">
          Find hele {{ korrespondance.titel }}
      </a>
    </div>
    {{ /if }}
  {{ /comp }}

  {{ for kasse of kasser.slice(1) }}
    {{ comp Indholdskasse }}
      {{ if kasse.overskrift }}
        {{ comp Indholdskassehoved }}
          <h2 class="font-serif text-3xl mb-2">{{ kasse.overskrift }}</h2>
        {{ /comp }}
      {{ /if }}
      {{ comp Indholdskasseindhold { css: kasse.kassecss || kassecss } }}
        <div class="overflow-x-hidden">
          {{ comp Afsnit { afsnit: kasse.afsnit, tekststoerrelse, tekststoerrelse_mobil, tekststoerrelse_computer, linjeafstand } }}
          {{ /comp }}
        </div>
      {{ /comp }}
    {{ /comp }}
  {{ /for }}

  {{ set svarliste = search.pages(`type=svar korrespondance_id=${id} udgivet=ja`, "dato=asc") }}
  {{ if svarliste.length }}
  <ul class="grid grid-cols-1 gap-8">
    {{ for svar of svarliste }}
      <li class="space-y-8" id="{{ svar.id }}">
        {{ comp Indholdskasse }}
          {{ comp Indholdskassehoved }}
            <h2 class="font-serif text-3xl mb-2">{{ svar.titel }}</h2>
            {{ comp Indholdskassesubtitel }}
              <time>{{ svar.dato |> date("HUMAN_DATE", "da") }}</time>
            {{ /comp }}
          {{ /comp }}
          {{ comp Indholdskasseindhold { css: svar.kassecss } }}
            <div class="overflow-x-hidden">
              {{ svar.content }}
              {{ if svar.afsnit }}
                {{ comp Afsnit { afsnit: svar.afsnit, tekststoerrelse: svar.tekststoerrelse, tekststoerrelse_mobil: svar.tekststoerrelse_mobil, tekststoerrelse_computer: svar.tekststoerrelse_computer, linjeafstand: svar.linjeafstand } }}
                {{ /comp }}
              {{ /if }}
            </div>
          {{ /comp }}
          {{ if svar.kunstner }}
            <div class="flex items-center gap-4 mt-8">
              {{ comp Kunstnerbillede { kunstner: svar.kunstner, klasse: "w-12 h-12" } }}
              {{ /comp }}
              <div>
                <a href="{{ svar.kunstner.url }}" class="font-serif text-lg hover:underline">{{ svar.kunstner.titel }}</a>
              </div>
            </div>
          {{ /if }}
        {{ /comp }}
        {{ comp Mindregrupopvaekkendelinje }}
        {{ /comp }}
      </li>
    {{ /for }}
  </ul>
  {{ /if }}

  {{ if kunstner }}
    {{ comp Indholdskasse }}
      <div class="px-2 lg:px-0 flex items-center gap-4 mb-4">
        {{ comp Kunstnerbillede { kunstner, klasse: "w-20 h-20" } }}
        {{ /comp }}
        <div>
          <h2 class="font-serif text-2xl{{ tekststoerrelse_mobil ? ' kort-navn' : '' }}"{{ if tekststoerrelse_mobil }} style="--mobil: {{ tekststoerrelse_mobil }}"{{ /if }}>{{ kunstner.titel }}</h2>
        </div>
      </div>

      <div class="px-2 lg:px-0 font-serif leading-relaxed text-zinc-700 mb-4{{ tekststoerrelse_mobil ? ' kort-tekst' : '' }}"{{ if tekststoerrelse_mobil }} style="--mobil: {{ tekststoerrelse_mobil }}"{{ /if }}>
        {{ kunstner.hurtigtekst |> md(true) }}
      </div>

      <div class="px-2 lg:px-0">
        <a href="{{ kunstner.url }}" class="inline-block border border-zinc-600 px-4 py-2 hover:border-violet-700 hover:text-violet-800 transition-all">
          Gå til {{ kunstner.titel }}s side
        </a>
      </div>
    {{ /comp }}
  {{ /if }}
</article>
{{ /comp }}